# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- ERCOT public reports API (Phase 1 ingestion) ---
# Register at https://apiexplorer.ercot.com/ for a subscription key.
# Required by: data-ingestion/phase_1_3_dataframe.py, phase_1_4, phase_1_5
ERCOT_API_USERNAME=
ERCOT_API_PASSWORD=
ERCOT_API_SUBSCRIPTION_KEY=

# --- PJM Data Miner 2 (optional, data-ingestion/ingest_jpm.py) ---
PJM_API_KEY=
# Override only if your account uses a different path.
PJM_RT_LMP_URL=https://api.pjm.com/api/v1/rt_lmp

# --- MISO (optional, data-ingestion/ingest_miso.py) ---
# Full URL to an endpoint returning real-time LMP data as CSV or JSON.
MISO_RT_LMP_URL=

# --- Database ---
# Every pipeline script tries PostgreSQL first and silently falls back to a
# local SQLite file (market_data.db) if the connection fails. Leaving these at
# their defaults is fine for local development.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=smart_dispatch

# --- Vector store (unused by the current code path) ---
# Phase 4.1 writes embeddings to market_embeddings.json on local disk rather
# than to Pinecone; this is here only for the PRD's original design.
PINECONE_API_KEY=
